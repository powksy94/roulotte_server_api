# Port HTTP de l'API (le front attend 3000)
PORT=3000
# Base SQLite
DATABASE_URL=file:./dev.db
# Secret de signature des JWT : 16 caractères au moins
JWT_SECRET=change-moi-avec-une-longue-chaine
# Durée de validité des jetons
JWT_EXPIRES_IN=2h
# Origine autorisée par CORS (le front)
CORS_ORIGIN=http://localhost:5173
# Niveau des logs : fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Dossier des photos des plats (servi sous /uploads, jamais commité)
UPLOADS_DIR=uploads
# Prestataire de paiement (simulateur du kit : npm run paiement)
PAYMENT_URL=http://localhost:4010
PAYMENT_API_KEY=sk_test_roulotte
# Délai maximum d'UNE tentative, et nombre de tentatives au plus
PAYMENT_TIMEOUT_MS=2000
PAYMENT_MAX_ATTEMPTS=3
# Implémentation du paiement : http (simulateur) ou fake (sans réseau)
PAYMENT_PROVIDER=http
# Attente avant la 2e tentative, doublée ensuite
PAYMENT_RETRY_BASE_MS=200