# Port HTTP de l'API (le front attend 3000)
PORT=3000
# Base SQLite
DATABASE_URL="file:./dev.db"
# Secret de signature des JWT : 16 caractères au moins
JWT_SECRET="change-moi-avec-une-longue-chaine"
# Durée de validité des jetons
JWT_EXPIRES_IN="2h"
# Origine autorisée par CORS (le front)
CORS_ORIGIN="http://localhost:5173"